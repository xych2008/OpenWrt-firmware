CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_qianmi_hd51=y

# 无线：MT7620A 内置 2.4G(mt76) + PCIe 探测（7610E/7612E 两套驱动都带）
CONFIG_PACKAGE_kmod-mt76x0e=y
CONFIG_PACKAGE_kmod-mt76x2=y

# 最简中文后台
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# USB / SD 卡（板载 SD 座走 USB 读卡）
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# 调试工具
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_pciutils=y

# 精简 16M 闪存
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_samba4 is not set
# CONFIG_PACKAGE_qbittorrent is not set
# CONFIG_PACKAGE_transmission is not set
