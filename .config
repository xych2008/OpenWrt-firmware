CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_lelink_le2=y

#无线驱动必备（QCA9531内置2.4G由ath9k驱动）
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_bridge-utils=y
CONFIG_PACKAGE_iw=y

#最简中文后台
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-network=y
CONFIG_PACKAGE_luci-system=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

#精简16M闪存，关闭冗余组件
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_samba4 is not set
# CONFIG_PACKAGE_qbittorrent is not set
# CONFIG_PACKAGE_transmission is not set
